[sub_resource type="GDScript" id="GDScript_qe1pe"]
script/source = "extends CharacterBody3D

# =====================================================
# MOVIMIENTO
# =====================================================

@export var speed: float = 6.0
@export var climb_speed: float = 5.0
@export var gravity: float = 9.8
@export var mouse_sensitivity: float = 0.002
@export var jump_force: float = 4.8

# =====================================================
# ESCALADA
# =====================================================

@export var stick_to_wall_force: float = 1.5
@export var climb_friction: float = 15.0
@export var climb_memory_time: float = 0.2
@export var normal_smooth_speed: float = 12.0

# =====================================================
# ESTAMINA
# =====================================================

@export var max_stamina: float = 100.0
@export var stamina_drain: float = 20.0
@export var stamina_recovery: float = 15.0

var stamina: float = 100.0
var exhausted: bool = false

# =====================================================
# CÁMARA
# =====================================================

@export var climb_camera_horizontal_limit: float = 65.0
@export var climb_camera_vertical_limit: float = 70.0

# =====================================================
# VARIABLES
# =====================================================

var is_climbing: bool = false
var climb_normal: Vector3 = Vector3.FORWARD
var climb_memory: float = 0.0

# =====================================================
# NODOS
# =====================================================

@onready var neck: Node3D = $CollisionShape3D/Neck
@onready var camara: Camera3D = $CollisionShape3D/Neck/Camera3D

# =====================================================
# RAYCASTS
# =====================================================

@onready var climb_ray_center: RayCast3D = $CollisionShape3D/Neck/ClimbRay_Central
@onready var climb_ray_right: RayCast3D = $CollisionShape3D/Neck/ClimbRay_Right
@onready var climb_ray_left: RayCast3D = $CollisionShape3D/Neck/ClimbRay_Left
@onready var climb_ray_up: RayCast3D = $CollisionShape3D/Neck/ClimbRay_Up
@onready var climb_ray_down: RayCast3D = $CollisionShape3D/Neck/ClimbRay_Foot

# =====================================================
# HUD
# =====================================================

@onready var stamina_ui = $\"../Estamina/Estamina/Control\"

# =====================================================
# ROTACIÓN
# =====================================================

var body_rotation_y: float = 0.0
var camera_rotation_x: float = 0.0

# =====================================================
# MULTIJUGADOR
# =====================================================

func _enter_tree() -> void:

	set_multiplayer_authority(name.to_int())

# =====================================================
# READY
# =====================================================

func _ready() -> void:

	camara.current = is_multiplayer_authority()

	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

	stamina = max_stamina

	stamina_ui.update_stamina(
		stamina,
		max_stamina
	)

# =====================================================
# OBTENER RAYCASTS
# =====================================================

func get_climb_rays() -> Array:

	return [
		climb_ray_center,
		climb_ray_right,
		climb_ray_left,
		climb_ray_up,
		climb_ray_down
	]

# =====================================================
# INPUT
# =====================================================

func _input(event: InputEvent) -> void:

	if Input.is_action_just_pressed(\"quit\"):

		$\"../\".exit_game(name.to_int())
		get_tree().quit()

	if event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:

		var horiz = -event.relative.x * mouse_sensitivity
		var vert = -event.relative.y * mouse_sensitivity

		camera_rotation_x += vert

		if is_climbing:

			neck.rotation.y += horiz

			neck.rotation.y = clamp(
				neck.rotation.y,
				deg_to_rad(-climb_camera_horizontal_limit),
				deg_to_rad(climb_camera_horizontal_limit)
			)

			camera_rotation_x = clamp(
				camera_rotation_x,
				deg_to_rad(-climb_camera_vertical_limit),
				deg_to_rad(climb_camera_vertical_limit)
			)

		else:

			body_rotation_y += horiz
			rotation.y = body_rotation_y

			neck.rotation.y = 0

			camera_rotation_x = clamp(
				camera_rotation_x,
				deg_to_rad(-85),
				deg_to_rad(85)
			)

		neck.rotation.x = camera_rotation_x

# =====================================================
# PHYSICS
# =====================================================

func _physics_process(delta: float) -> void:

	# =====================================================
	# DETECTAR PARED
	# =====================================================

	var touching_wall := false

	for ray in get_climb_rays():

		if ray.is_colliding():

			touching_wall = true
			break

	# =====================================================
	# MEMORIA ESCALADA
	# =====================================================

	if touching_wall:

		climb_memory = climb_memory_time

	else:

		climb_memory -= delta

	# =====================================================
	# ACTIVAR ESCALADA
	# =====================================================

	is_climbing = (
		Input.is_action_pressed(\"Trepar\")
		and climb_memory > 0.0
		and stamina > 0.0
		and !exhausted
	)

	# =====================================================
	# AJUSTES DEL SUELO
	# =====================================================

	set_floor_stop_on_slope_enabled(!is_climbing)

	# =====================================================
	# PROMEDIAR NORMALES
	# =====================================================

	if touching_wall:

		var normals := []

		for ray in get_climb_rays():

			if ray.is_colliding():

				normals.append(
					ray.get_collision_normal()
				)

		if normals.size() > 0:

			var avg_normal := Vector3.ZERO

			for n in normals:

				avg_normal += n

			avg_normal /= normals.size()

			climb_normal = climb_normal.slerp(
				avg_normal.normalized(),
				normal_smooth_speed * delta
			).normalized()

	# =====================================================
	# ESTAMINA
	# =====================================================

	if is_climbing:

		stamina -= stamina_drain * delta

		stamina = clamp(
			stamina,
			0.0,
			max_stamina
		)

		stamina_ui.update_stamina(
			stamina,
			max_stamina
		)

		if stamina <= 0.0:

			exhausted = true
			is_climbing = false

			velocity.y = -8.0

	else:

		stamina += stamina_recovery * delta

		stamina = clamp(
			stamina,
			0.0,
			max_stamina
		)

		stamina_ui.update_stamina(
			stamina,
			max_stamina
		)

		if stamina >= 30.0:

			exhausted = false

	# =====================================================
	# MOVIMIENTO
	# =====================================================

	if is_climbing:

		_climbing_movement(delta)

	else:

		_normal_movement(delta)

	move_and_slide()

# =====================================================
# ESCALADA
# =====================================================

func _climbing_movement(delta: float) -> void:

	# Elimina residuos de gravedad
	velocity = Vector3.ZERO

	var input_dir := Input.get_vector(
		\"Izquierda\",
		\"Derecha\",
		\"Adelante\",
		\"Atras\"
	)

	# =====================================================
	# DIRECCIONES RELATIVAS A LA PARED
	# =====================================================

	var right := Vector3.UP.cross(climb_normal).normalized()

# Evita inversión de controles
	if right.dot(camara.global_transform.basis.x) < 0:

		right = -right

# ESTA ES LA LÍNEA IMPORTANTE
	var up_on_wall := right.cross(climb_normal).normalized()

	# =====================================================
	# DIRECCIÓN FINAL
	# =====================================================

	var move_direction := (
		right * input_dir.x +
		up_on_wall * input_dir.y
	)

	if move_direction.length() > 0.01:

		move_direction = move_direction.normalized()

	# =====================================================
	# VELOCIDAD
	# =====================================================

	velocity = move_direction * climb_speed

	# =====================================================
	# PEGARSE A LA PARED
	# =====================================================

	velocity += -climb_normal * stick_to_wall_force

	# =====================================================
	# FRICCIÓN
	# =====================================================

	if input_dir.length() < 0.1:

		velocity = velocity.lerp(
			Vector3.ZERO,
			climb_friction * delta
		)

# =====================================================
# MOVIMIENTO NORMAL
# =====================================================

func _normal_movement(delta: float) -> void:

	# =====================================================
	# GRAVEDAD
	# =====================================================

	if not is_on_floor():

		velocity.y -= gravity * delta

	# =====================================================
	# INPUT
	# =====================================================

	var input_dir := Input.get_vector(
		\"Izquierda\",
		\"Derecha\",
		\"Adelante\",
		\"Atras\"
	)

	var direction := (
		transform.basis *
		Vector3(input_dir.x, 0, input_dir.y)
	).normalized()

	# =====================================================
	# MOVIMIENTO
	# =====================================================

	if direction.length() > 0:

		velocity.x = direction.x * speed
		velocity.z = direction.z * speed

	else:

		velocity.x = move_toward(
			velocity.x,
			0.0,
			25.0
		)

		velocity.z = move_toward(
			velocity.z,
			0.0,
			25.0
		)

	# =====================================================
	# SALTO
	# =====================================================

	if Input.is_action_just_pressed(\"Saltar\") and is_on_floor():

		velocity.y = jump_force
"

