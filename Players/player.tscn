[gd_scene load_steps=5 format=3 uid="uid://dqpdwn6vexrv5"]

[sub_resource type="GDScript" id="GDScript_qe1pe"]
script/source = "extends CharacterBody3D

# =====================================================
# MOVIMIENTO
# =====================================================

@export var speed: float = 6.0
@export var climb_speed: float = 5.0
@export var gravity: float = 9.8
@export var mouse_sensitivity: float = 0.002
@export var jump_force: float = 4.8

# =====================================================
# ESCALADA
# =====================================================

@export var stick_to_wall_force: float = 12.0
@export var climb_friction: float = 15.0

# MEMORIA DE ESCALADA
@export var climb_memory_time: float = 0.2

# SUAVIZADO DE NORMALES
@export var normal_smooth_speed: float = 10.0

# =====================================================
# ESTAMINA
# =====================================================

@export var max_stamina: float = 100.0
@export var stamina_drain: float = 20.0
@export var stamina_recovery: float = 15.0

var stamina: float = 100.0
var exhausted: bool = false

# =====================================================
# CÁMARA
# =====================================================

@export var climb_camera_horizontal_limit: float = 65.0
@export var climb_camera_vertical_limit: float = 70.0

# =====================================================
# VARIABLES
# =====================================================

var is_climbing: bool = false
var climb_normal: Vector3 = Vector3.FORWARD
var climb_memory: float = 0.0

# =====================================================
# NODOS
# =====================================================

@onready var neck: Node3D = $CollisionShape3D/Neck
@onready var climb_ray: RayCast3D = $CollisionShape3D/Neck/Camera3D/ClimbRay_foot
@onready var camara = $CollisionShape3D/Neck/Camera3D

# HUD ESTAMINA
@onready var stamina_ui = $\"../Estamina/Estamina/Control\"

# =====================================================
# ROTACIÓN
# =====================================================

var body_rotation_y: float = 0.0
var camera_rotation_x: float = 0.0

# =====================================================
# MULTIJUGADOR
# =====================================================

func _enter_tree() -> void:
	set_multiplayer_authority(name.to_int())

# =====================================================
# READY
# =====================================================

func _ready() -> void:

	camara.current = is_multiplayer_authority()

	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

	stamina = max_stamina

	# HUD
	stamina_ui.update_stamina(stamina, max_stamina)

	# RAYCAST
	if climb_ray:

		climb_ray.enabled = true

		# MÁS LARGO PARA EVITAR BUGS
		climb_ray.target_position = Vector3(0, 0, -4.0)

# =====================================================
# INPUT
# =====================================================

func _input(event: InputEvent) -> void:

	if Input.is_action_just_pressed(\"quit\"):

		$\"../\".exit_game(name.to_int())
		get_tree().quit()

	if event is InputEventMouseMotion and Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:

		var horiz = -event.relative.x * mouse_sensitivity
		var vert = -event.relative.y * mouse_sensitivity

		# =====================================================
		# ROTACIÓN VERTICAL
		# =====================================================

		camera_rotation_x += vert

		# =====================================================
		# ROTACIÓN HORIZONTAL
		# =====================================================

		if is_climbing:

			if neck:

				neck.rotation.y += horiz

				neck.rotation.y = clamp(
					neck.rotation.y,
					deg_to_rad(-climb_camera_horizontal_limit),
					deg_to_rad(climb_camera_horizontal_limit)
				)

				camera_rotation_x = clamp(
					camera_rotation_x,
					deg_to_rad(-climb_camera_vertical_limit),
					deg_to_rad(climb_camera_vertical_limit)
				)

		else:

			body_rotation_y += horiz
			rotation.y = body_rotation_y

			if neck:
				neck.rotation.y = 0

			camera_rotation_x = clamp(
				camera_rotation_x,
				deg_to_rad(-85),
				deg_to_rad(85)
			)

		if neck:
			neck.rotation.x = camera_rotation_x

# =====================================================
# PHYSICS PROCESS
# =====================================================

func _physics_process(delta: float) -> void:

	# =====================================================
	# DETECCIÓN DE PARED
	# =====================================================

	var touching_wall = (
		climb_ray
		and climb_ray.is_colliding()
	)

	# =====================================================
	# MEMORIA DE ESCALADA
	# =====================================================

	if touching_wall:

		climb_memory = climb_memory_time

	else:

		climb_memory -= delta

	# =====================================================
	# ACTIVAR ESCALADA
	# =====================================================

	is_climbing = (
		Input.is_action_pressed(\"Trepar\")
		and climb_memory > 0.0
		and stamina > 0
		and !exhausted
	)

	# =====================================================
	# SUAVIZAR NORMALES
	# =====================================================

	if touching_wall:

		var target_normal = climb_ray.get_collision_normal()

		climb_normal = climb_normal.slerp(
			target_normal,
			normal_smooth_speed * delta
		).normalized()

	# =====================================================
	# SISTEMA DE ESTAMINA
	# =====================================================

	if is_climbing:

		stamina -= stamina_drain * delta
		stamina = clamp(stamina, 0.0, max_stamina)

		stamina_ui.update_stamina(stamina, max_stamina)

		# =====================================================
		# SIN ESTAMINA = CAER
		# =====================================================

		if stamina <= 0:

			exhausted = true
			is_climbing = false

			velocity.y = -8.0

	else:

		stamina += stamina_recovery * delta
		stamina = clamp(stamina, 0.0, max_stamina)

		stamina_ui.update_stamina(stamina, max_stamina)

		# =====================================================
		# RECUPERAR CANSANCIO
		# =====================================================

		if stamina >= 30.0:
			exhausted = false

	# =====================================================
	# MOVIMIENTO
	# =====================================================

	if is_climbing:
		_climbing_movement(delta)
	else:
		_normal_movement(delta)

	move_and_slide()

# =====================================================
# MOVIMIENTO ESCALADA
# =====================================================

func _climbing_movement(delta: float) -> void:

	var camera_forward = -neck.global_transform.basis.z.normalized()

	# =====================================================
	# DIRECCIÓN DERECHA SOBRE LA PARED
	# =====================================================

	var right = climb_normal.cross(camera_forward)

	# EVITAR BUGS SI LAS DIRECCIONES SON PARALELAS
	if right.length() < 0.05:

		right = neck.global_transform.basis.x

	right = right.normalized()

	# =====================================================
	# CORREGIR ORIENTACIÓN
	# =====================================================

	if right.dot(neck.global_transform.basis.x) < 0:
		right = -right

	# =====================================================
	# DIRECCIÓN ARRIBA SOBRE PARED
	# =====================================================

	var up_on_wall = right.cross(climb_normal).normalized()

	# =====================================================
	# INPUT
	# =====================================================

	var input = Input.get_vector(
		\"Izquierda\",
		\"Derecha\",
		\"Adelante\",
		\"Atras\"
	)

	# =====================================================
	# MOVIMIENTO BASE
	# =====================================================

	var target_velocity = (
		right * input.x * climb_speed +
		up_on_wall * input.y * climb_speed
	)

	# =====================================================
	# SUAVIZAR MOVIMIENTO
	# =====================================================

	velocity = velocity.lerp(
		target_velocity,
		8.0 * delta
	)

	# =====================================================
	# PEGARSE A LA PARED
	# =====================================================

	velocity += -climb_normal * stick_to_wall_force

	# =====================================================
	# FRICCIÓN
	# =====================================================

	if input.length() < 0.1:

		velocity = velocity.lerp(
			Vector3.ZERO,
			climb_friction * delta
		)

# =====================================================
# MOVIMIENTO NORMAL
# =====================================================

func _normal_movement(delta: float) -> void:

	# =====================================================
	# GRAVEDAD
	# =====================================================

	if not is_on_floor():

		velocity.y -= gravity * delta

	# =====================================================
	# INPUT MOVIMIENTO
	# =====================================================

	var input_dir = Input.get_vector(
		\"Izquierda\",
		\"Derecha\",
		\"Adelante\",
		\"Atras\"
	)

	var direction = (
		transform.basis *
		Vector3(input_dir.x, 0, input_dir.y)
	).normalized()

	# =====================================================
	# MOVIMIENTO
	# =====================================================

	if direction.length() > 0:

		velocity.x = direction.x * speed
		velocity.z = direction.z * speed

	else:

		velocity.x = move_toward(velocity.x, 0, 25)
		velocity.z = move_toward(velocity.z, 0, 25)

	# =====================================================
	# SALTO
	# =====================================================

	if Input.is_action_just_pressed(\"Saltar\") and is_on_floor():

		velocity.y = jump_force
"

